API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_BASE=https://v3.football.api-sports.io
DEFAULT_COUNTRY=Italy
DEFAULT_LEAGUE=Serie A
DEFAULT_SEASON=2026

# Cache backend: sqlite (default, file locale, nessun demone) | redis | auto
CACHE_BACKEND=sqlite
CACHE_DB_PATH=data/footy_predictor.db

# Redis Configuration (OPZIONALE: serve solo con CACHE_BACKEND=redis o auto)
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL=true
REDIS_DB=0

# Bookmaker preferences for odds (optional)
# PRIMARY_BOOKMAKER=8          # Bet365 (default)
# PREFERRED_BOOKMAKERS=[8]     # Bet365 only (default)
